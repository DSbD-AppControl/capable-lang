func printLn(msg : String) -> Unit
{
  print(msg);
  print(toString('\n'))
}

role Client
role Server

newtype Msg(String)

union cmd { msg  : Msg
          ; quit : Msg
          }

protocol Echo
  = rec(x)
  . Client ==> Server [cmd]
    { msg(Msg)  . Server ==> Client | Msg(String) . call(x)
    | quit(Msg) . Server ==> Client | Msg(String) . end
    }

session echoClientProgram <Echo as Client>(i : String) -> Bool
{
    ?rhs
}

-- ### Program Entry Point
main (args : [String])
{
  local val = "Hello World";
  printLn("End");
  unit
}

-- [ EOF ]
