func printLn(msg : String) -> Unit
{
  print(msg);
  print(toString('\n'))
}

role Client
role Server

newtype RESP(String)

union cmd { msg  : String
          ; quit : String
          }

union MaybeStr { nout : Unit; this : String }

protocol Echo
  = rec(x)
  . Client ==> Server [cmd]
    { msg(String)  . Server ==> Client | RESP(String) . call(x)
    | quit(String) . Server ==> Client | RESP(String) . end
    }


session echoClientProgram <Echo as Client>(s : String) -> MaybeStr
{
  loop(x)
  {
    send [cmd] Server quit(s)
    catch
    {
      crash(nout(unit))
    }
    recv [RESP] Server
    {
      when RESP(value)
      {
        end(this(value))
      }
    } catch
    {
      crash(nout(unit))
    }
  }
}


session echoClientProcess <Echo as Client>(c : cmd) -> MaybeStr
{
  loop(x)
  {
    match c
    {
      when msg(m)
      {
        send [cmd] Server msg(m) catch { crash(nout(unit)) }
        recv [RESP] Server
        {
          when RESP(value) { printLn(value); call(x) }
        } catch { crash(nout(unit)) }
      }
      when quit(m)
      {
        send [cmd] Server quit(m) catch { crash(nout(unit)) }
        recv [RESP] Server
        {
          when RESP(value) { end(this(value)) }
        } catch { crash(nout(unit)) }
      }
    }
  }
}

-- ### Program Entry Point
main (args : [String])
{
  local val = "Hello World";

  -- Run a session, assigning processes to roles.

  match run echoClientProgram(val) with [Server as "python3 pingping.py" ]
  { when nout(u) { printLn("Echo Failed") }
    when this(m) { print("Last Echo was"); printLn(m) }
  }
}

-- [ EOF ]
